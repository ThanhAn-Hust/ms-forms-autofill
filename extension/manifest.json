{
  "manifest_version": 3,
  "name": "MS Forms PDF Autofill",
  "version": "1.0.0",
  "description": "Đọc đáp án từ file PDF Save my response của Microsoft Forms và tự động điền sang Form tương ứng ngay trên trình duyệt.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://forms.office.com/*",
    "https://forms.cloud.microsoft/*",
    "https://*.office.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "MS Forms PDF Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://forms.office.com/*",
        "https://forms.cloud.microsoft/*",
        "https://*.office.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "src/matcher.js",
        "src/dom-filler.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.min.mjs",
        "lib/pdf.worker.min.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
